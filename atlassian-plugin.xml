<atlassian-plugin key="com.saael.nodeforms" name="Редактор нод" plugins-version="2">
    <plugin-info>
        <description><![CDATA[
            <p>Свой редактор правил автоматизации. Ставится рядом с Automation for Jira, работает с теми же правилами и тоже их исполняет.</p>
        ]]></description>
        <version>1.0.3</version>
        <vendor name="Saael" url="https://github.com/SaaelCompany/auto-jira"/>
        <param name="plugin-icon">images/plugin/plugin-icon.png</param>
        <param name="plugin-logo">images/plugin/plugin-logo.png</param>
        <param name="plugin-banner">images/plugin/plugin-banner.png</param>
        <param name="vendor-icon">images/plugin/vendor-icon.png</param>
        <param name="vendor-logo">images/plugin/vendor-logo.png</param>
        <param name="atlassian-data-center-status">compatible</param>
        <param name="atlassian-data-center-compatible">true</param>
        <param name="configure.url">/plugins/servlet/node-forms</param>
        <param name="post.install.url">/plugins/servlet/node-forms</param>
    </plugin-info>

    <resource type="i18n" name="i18n" location="com/saael/nodeforms/i18n"/>

    <servlet key="node-forms-servlet" name="Редактор нод" class="com.saael.nodeforms.NodeCanvasServlet">
        <description>Страница редактора правил</description>
        <url-pattern>/node-forms</url-pattern>
    </servlet>

    <web-resource key="node-canvas" name="Редактор нод">
        <resource type="download" name="node-canvas.css" location="page/nodes/node-canvas.css"/>
        <resource type="download" name="node-canvas.js" location="page/nodes/node-canvas.js"/>
    </web-resource>

    <web-section key="node-forms-section" name="Редактор нод" location="top_system_section" weight="40">
        <label key="com.saael.nodeforms.section"/>
    </web-section>

    <web-item key="node-forms-item" name="Редактор нод" section="top_system_section/node-forms-section" weight="10">
        <label key="com.saael.nodeforms.menu"/>
        <link linkId="node-forms-admin">/plugins/servlet/node-forms</link>
        <condition class="com.atlassian.jira.plugin.webfragment.conditions.UserIsAdminCondition"/>
    </web-item>

    <web-item key="node-forms-project" name="Редактор нод" section="atl.jira.proj.config/projectgroup4" weight="500">
        <label key="com.saael.nodeforms.project"/>
        <link linkId="node-forms-project">/plugins/servlet/node-forms?projectKey=$projectKeyEncoded</link>
        <condition class="com.atlassian.jira.plugin.webfragment.conditions.UserIsProjectAdminCondition"/>
    </web-item>

    <ao key="node-forms-automation-ao" namespace="com.codebarrel.automation.ao">
        <namespace>com.codebarrel.addons.automation</namespace>
        <description>Те же таблицы правил, что у Automation for Jira. Задачи обновления схемы не запускаются.</description>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleConfig</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleCfgComponent</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleTag</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleSchedule</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.AuditItem</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.AuditItemProject</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.AuditItemAscItem</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.AuditItemCgeItem</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.AuditItemCompCge</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleCfgProjAssoc</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.Counters</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.LegacyRuleLink</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.AutomationQueue</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleStat</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleStateLatest</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleStatRollupMin</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleStatRollupHr</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleStatRollupDay</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleLabel</entity>
        <entity>com.codebarrel.jira.plugin.automation.ao.RuleToLabel</entity>
    </ao>
</atlassian-plugin>
