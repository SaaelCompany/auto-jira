<atlassian-plugin key="com.saael.nodeforms" name="Niout Auto to Jira" plugins-version="2">
    <plugin-info>
        <description><![CDATA[
            <p>Свой редактор правил автоматизации. Ставится рядом с Automation for Jira и работает с теми же правилами.</p>
        ]]></description>
        <version>1.0.14</version>
        <vendor name="Saael" url="https://github.com/SaaelCompany/auto-jira"/>
        <param name="plugin-icon">images/plugin/plugin-icon.png</param>
        <param name="plugin-logo">images/plugin/plugin-logo.png</param>
        <param name="plugin-banner">images/plugin/plugin-banner.png</param>
        <param name="vendor-icon">images/plugin/vendor-icon.png</param>
        <param name="vendor-logo">images/plugin/vendor-logo.png</param>
        <param name="atlassian-data-center-status">compatible</param>
        <param name="atlassian-data-center-compatible">true</param>
        <param name="configure.url">/download/resources/com.saael.nodeforms:node-canvas/index.html</param>
        <param name="post.install.url">/download/resources/com.saael.nodeforms:node-canvas/index.html</param>
    </plugin-info>

    <resource type="i18n" name="i18n" location="com/saael/nodeforms/i18n"/>

    <web-resource key="node-canvas" name="Редактор нод">
        <resource type="download" name="index.html" location="page/nodes/index.html">
            <param name="content-type" value="text/html;charset=UTF-8"/>
        </resource>
        <resource type="download" name="node-canvas.css" location="page/nodes/node-canvas.css"/>
        <resource type="download" name="node-canvas.js" location="page/nodes/node-canvas.js"/>
    </web-resource>

    <sitemesh key="node-forms-decoration" name="Niout Auto to Jira" path="/download/resources/com.saael.nodeforms"/>

    <web-section key="node-forms-section" name="Niout Auto to Jira" location="top_system_section" weight="40">
        <label key="com.saael.nodeforms.section"/>
    </web-section>

    <web-item key="node-forms-item" name="Автоматизация" section="top_system_section/node-forms-section" weight="10">
        <label key="com.saael.nodeforms.menu"/>
        <link linkId="node-forms-admin">/download/resources/com.saael.nodeforms:node-canvas/index.html</link>
    </web-item>

    <web-item key="node-forms-project" name="Автоматизация" section="atl.jira.proj.config/projectgroup4" weight="500">
        <label key="com.saael.nodeforms.project"/>
        <link linkId="node-forms-project">/download/resources/com.saael.nodeforms:node-canvas/index.html?projectKey=$projectKeyEncoded</link>
    </web-item>
</atlassian-plugin>
